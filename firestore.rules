rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'lastUpdated']) &&
             data.email is string && data.email.size() <= 256 &&
             data.lastUpdated == request.time;
    }

    function isValidPack(data) {
      return data.name is string && data.name.size() <= 100 &&
             (data.get('id', null) == null || data.get('id', '') is string) &&
             (data.get('color', 'indigo') is string) &&
             (data.get('inputText', null) == null || data.get('inputText', '') is string) &&
             (data.get('setSize', 0) is number) &&
             (data.get('deleteAt', null) == null || data.get('deleteAt', 0) is number || data.get('deleteAt', 0) is timestamp) &&
             (data.get('questionCount', 0) is number) &&
             (data.get('createdAt', null) == null || data.get('createdAt', 0) == request.time || data.get('createdAt', 0) is timestamp || data.get('createdAt', 0) is number) &&
             (data.get('lastStudied', null) == null || data.get('lastStudied', 0) == request.time || data.get('lastStudied', 0) is timestamp || data.get('lastStudied', 0) is number);
    }

    function isValidQuestionsData(data) {
      return data.get('states', []) is list &&
             (data.get('lastUpdated', 0) == request.time || data.get('lastUpdated', 0) is timestamp);
    }

    function isValidSetsData(data) {
      return data.get('mastery', {}) is map &&
             (data.get('lastUpdated', 0) == request.time || data.get('lastUpdated', 0) is timestamp);
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());

      match /packs/{packId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPack(incoming());
        allow delete: if isOwner(userId);

        match /data/{docId} {
          allow get: if isOwner(userId);
          allow create, update: if isOwner(userId) && (
            (docId == 'questions' && isValidQuestionsData(incoming())) ||
            (docId == 'sets' && isValidSetsData(incoming()))
          );
          allow delete: if isOwner(userId);
        }
        
        // Legacy support
        match /{allPaths=**} {
           allow read, write: if isOwner(userId);
        }
      }

      match /config/progress {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
