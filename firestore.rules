rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'lastUpdated']) &&
             data.email is string && data.email.size() <= 256 &&
             data.lastUpdated == request.time;
    }

    function isValidPack(data) {
      return data.name is string && data.name.size() <= 100 &&
             (data.id == null || data.id is string) &&
             (data.color == null || (data.color is string && data.color.size() <= 20)) &&
             (data.deleteAt == null || data.deleteAt is number || data.deleteAt is timestamp) &&
             (data.inputText == null || (data.inputText is string && data.inputText.size() <= 100000)) &&
             (data.setSize == null || (data.setSize is number && data.setSize >= 1 && data.setSize <= 100)) &&
             (data.questionCount == null || (data.questionCount is number)) &&
             (data.createdAt == null || data.createdAt == request.time || data.createdAt is timestamp || data.createdAt is number) &&
             (data.lastStudied == null || data.lastStudied == request.time || data.lastStudied is timestamp || data.lastStudied is number) &&
             (data.lastUpdated == null || data.lastUpdated == request.time || data.lastUpdated is timestamp || data.lastUpdated is number);
    }

    function isValidQuestionsData(data) {
      return data.states is list && data.states.size() <= 2000 &&
             (data.lastUpdated == request.time || data.lastUpdated is timestamp);
    }

    function isValidSetsData(data) {
      return data.mastery is map && data.mastery.size() <= 200 &&
             (data.lastUpdated == request.time || data.lastUpdated is timestamp);
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['email', 'lastUpdated']);

      match /packs/{packId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(packId) && isValidPack(incoming());
        allow update: if isOwner(userId) && isValidPack(incoming());
        allow delete: if isOwner(userId);

        match /data/{docId} {
          allow get: if isOwner(userId);
          allow create, update: if isOwner(userId) && (
            (docId == 'questions' && isValidQuestionsData(incoming())) ||
            (docId == 'sets' && isValidSetsData(incoming()))
          );
          allow delete: if isOwner(userId);
        }

        // Legacy/Migration paths
        match /questions/{qId} {
          allow read, write: if isOwner(userId);
        }
        match /sets/{sId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /config/progress {
        allow read, write: if isOwner(userId);
      }
      match /questions/{qId} {
        allow read, write: if isOwner(userId);
      }
      match /sets/{sId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
