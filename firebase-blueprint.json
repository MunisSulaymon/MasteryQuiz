{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "QuizPack": {
      "title": "Quiz Pack",
      "description": "A collection of questions and study progress",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastStudied": { "type": "string", "format": "date-time" },
        "questionCount": { "type": "number" },
        "inputText": { "type": "string" },
        "setSize": { "type": "number" }
      }
    },
    "QuestionsData": {
      "title": "Questions Data",
      "description": "Optimized document for question boxes and progress",
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "box": { "type": "number" },
              "wrongCount": { "type": "number" }
            }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "SetsData": {
      "title": "Sets Data",
      "description": "Optimized document for mastery metrics",
      "type": "object",
      "properties": {
        "mastery": { "type": "object" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile"
    },
    "/users/{userId}/packs/{packId}": {
      "schema": "QuizPack",
      "description": "Quiz packs owned by the user"
    },
    "/users/{userId}/packs/{packId}/data/questions": {
      "schema": "QuestionsData",
      "description": "Question box states for the pack"
    },
    "/users/{userId}/packs/{packId}/data/sets": {
      "schema": "SetsData",
      "description": "Set mastery data for the pack"
    }
  }
}
